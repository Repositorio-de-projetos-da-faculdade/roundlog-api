# apps/api/.env (template — copie como .env e preencha)
DATABASE_URL="postgresql://user:password@localhost:5432/roundlog"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="sua-chave-secreta-muito-longa-aqui"
JWT_REFRESH_SECRET="outra-chave-secreta-aqui"
COOKIE_SECRET="terceira-chave-secreta-para-cookies"
GEMINI_API_KEY=""
STORAGE_URL="local"
RESEND_API_KEY=""
PORT=3001
NODE_ENV="development"
WEB_ORIGINS="http://localhost:3000,http://localhost:3002"
# Push (VAPID) — gerar via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""

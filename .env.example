# RoundLog — variáveis de ambiente (template do orquestrador docker-compose)
# ──────────────────────────────────────────────────────────────────────
# Copie para .env e preencha. O docker-compose.yml lê automaticamente.
#
# Os valores marcados com "TROCAR" são obrigatórios. Os demais funcionam
# como estão pra rodar local. Em demo/estudo dá pra deixar quase tudo
# como está e só preencher o GEMINI_API_KEY.
# ──────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_DB=roundlog
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ── Segredos (gere com: openssl rand -hex 32) ─────────────────────────
# Em local/demo pode deixar os exemplos abaixo. NUNCA usar em produção.
JWT_SECRET=dev-jwt-secret-troque-em-producao-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-troque-em-producao-min-32-chars
COOKIE_SECRET=dev-cookie-secret-troque-em-producao-min-32-chars

# ── Google Gemini (OBRIGATÓRIO pra fluxo de áudio funcionar) ──────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=TROCAR-cole-sua-chave-do-google-ai-studio

# ── E-mail (opcional — só envia se preenchido) ────────────────────────
# Free tier: https://resend.com
RESEND_API_KEY=

# ── Push Notifications VAPID (opcional pro PWA) ───────────────────────
# Gerar com: npx web-push generate-vapid-keys
# Sem isso, o sino de push só funciona como histórico in-app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@roundlog.dev
